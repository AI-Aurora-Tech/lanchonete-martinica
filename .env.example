# Copie para `.env.local` e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Na Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: domínio usado para montar o e-mail de login a partir do usuário
# (caixa -> caixa@lanchonete-martinica.app). Precisa ser o mesmo para todos.
# VITE_LOGIN_EMAIL_DOMAIN=lanchonete-martinica.app
